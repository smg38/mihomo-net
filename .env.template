# =============================================================================
#  1. УДАЛЁННОЕ РАЗВЁРТЫВАНИЕ (используется только scripts/publish.sh)
# =============================================================================
# Эти переменные нужны ТОЛЬКО на машине разработчика, когда вы запускаете
#   mise run publish
# На самом сервере они не используются — там всё уже разложено.

# Имя пользователя SSH на целевом сервере.
# Должно совпадать с тем, к кому у вас есть ssh-доступ без пароля (BatchMode).
# Разрешены только: a-z A-Z 0-9 _ . -
REMOTE_USER=root

# Хост или IP целевого сервера.
REMOTE_HOST=

# Абсолютный путь к производственному каталогу НА СЕРВЕРЕ.
# Сюда будут положены: config.yaml, cn_cidr.txt, .env, .update-state/, ui/, scripts/
# Не может быть "/" и не может быть относительным.
REMOTE_DIR=/root/mihomo

# =============================================================================
#  2. КЛЮЧ ПАНЕЛИ УПРАВЛЕНИЯ
# =============================================================================
# Ключ для доступа к веб-панели управления (:8000) и к MetaCubeXD (:9900).
#
# ВАЖНО: если MIHOMO_SECRET пуст — панель доступна ТОЛЬКО с 127.0.0.1/::1.
#        То есть с другого компьютера вы её не откроете вообще.
#
# Рекомендуется длинная случайная строка (32+ символа).
# Пример генерации: openssl rand -hex 32
MIHOMO_SECRET=

# =============================================================================
#  3. ПОДПИСКА
# =============================================================================
# URL YAML-конфигурации от вашего VPN-провайдера.
# Проект скачивает его при обновлении и накладывает свои переопределения
# (порты, DNS, tproxy, external-controller и т.д.).
#
# Куда скачивается: .update-state/transaction.json (снимок) → config.yaml (активный)
# Кто скачивает:    deploy/scripts/update.sh через deploy/lib/http.sh
CONFIG_URL=

# =============================================================================
#  4. ПРОКСИ ДЛЯ ЗАГРУЗКИ (опционально)
# =============================================================================
# GitHub в некоторых регионах медленный или заблокирован. Эти префиксы
# позволяют качать релизы ядра Mihomo и панель MetaCubeXD через зеркало.
# Применяются ТОЛЬКО к публичным GitHub URL — подписка (CONFIG_URL) всегда
# качается напрямую с указанного вами адреса.

# Префикс прокси для GitHub-релизов.
# Пример: https://gh.example.com/  (со слешем на конце или без — добавляется сам)
GITHUB_PROXY=

# Префикс для GitHub API (запрос последней версии Mihomo).
# ВНИМАНИЕ: обычные gh-proxy его НЕ поддерживают. Нужен специальный форк,
# например https://github.com/zzc-tongji/gh-proxy
# API-запрос всего один — можно оставить пустым и просто подождать.
GITHUB_API_PROXY=

# =============================================================================
#  5. DoH-ФОЛБЭК ДЛЯ ЗАГРУЗОК (опционально)
# =============================================================================
# Если системный DNS не резолвит (например, провайдер подменяет ответы),
# проект переключается на DNS over HTTPS.
#
# Формат: "host:bootstrapped-IP host2:bootstrapped-IP" (через пробел).
# Bootstrapped-IP — это IP, по которому резолвится сам DoH-сервер
# (чтобы не зависеть от системного DNS при установке TLS).
#
# Оставить пустым  → отключить внешний DoH (останется только системный DNS)
# Заменить на своё  → внутренний DoH, /dns-query, HTTPS-сертификат должен быть
#                     установлен как доверенный в системе.
DOWNLOAD_DOH_SERVERS="dns.alidns.com:223.5.5.5 cloudflare-dns.com:1.1.1.1"

# =============================================================================
#  6. ПРОГРЕСС ЗАГРУЗКИ
# =============================================================================
# auto — показывать индикатор только если stdout — терминал (или SSH-публикация
#        передала факт наличия локального TTY).
#        Журналы cron и systemd остаются чистыми.
# bar  — всегда показывать (даже в cron-логах).
# off  — никогда.
DOWNLOAD_PROGRESS=auto

# =============================================================================
#  7. ПОВЕДЕНИЕ ПРОЗРАЧНОГО ПРОКСИ
# =============================================================================
# Читается в deploy/scripts/entrypoint.sh — этот скрипт запускает ядро
# Mihomo и настраивает nftables при старте службы mihomo.service.

# true  — китайские IP (cn_cidr.txt) идут НАПРЯМУЮ, минуя прокси.
#         Список cn_cidr.txt скачивается раз в сутки.
# false — весь трафик через Mihomo (список не скачивается).
SKIP_CNIP=true

# true  — QUIC (UDP/443) разрешён.
# false — QUIC блокируется в INPUT chain: `udp dport 443 reject`.
#         Полезно, если QUIC ломает проксирование (частая проблема).
QUIC=true

# true  — трафик САМОГО сервера (OUTPUT chain) тоже заворачивается в TProxy.
#         ОПАСНО: если прокси не работает — вы теряете SSH-доступ к серверу
#         и придётся идти через IPMI/KVM/спасение у хостера.
# false — локальный трафик идёт напрямую (безопасно по умолчанию).
LOCAL_LOOPBACK_PROXY=false

# =============================================================================
#  8. ПОРТ ВЕБ-ПАНЕЛИ
# =============================================================================
# Порт, на котором слушает mihomo-manager (веб-сервер на Go).
# Менеджер читает это значение при старте (internal/manager/server.go:getPort).
#
# ВАЖНО: если поменяете — не забудьте закрыть/открыть порт в firewall.
# 80  — если хотите открывать http://<server> без порта (нужен root или CAP_NET_BIND_SERVICE).
# 8000 — по умолчанию, если PORT не задан.
PORT=80

# =============================================================================
#  9. ВЕРСИИ ИНСТРУМЕНТОВ (только для справки — управляется mise.toml)
# =============================================================================
# Go 1.26.8 — фиксируется через mise.toml, GOTOOLCHAIN=local.
# Менять здесь не нужно и не получится.