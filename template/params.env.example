# Copy to build/keys/params.env and replace all example values.
# Configuration values must be literal; variable references are rejected.

# --- Common ---
MIHOMO_VERSION=v1.19.33
SERVERNAME=dl.google.com
FINGERPRINT=chrome
FLOW_AB=xtls-rprx-vision
FLOW_USERS=xtls-rprx-vision
METHOD=chacha20-ietf-poly1305
REMOTE_USER=root

# --- Server A ---
LOCAL_A=1
IP_A=192.168.10.88
PORT_A=8443
DIR_A=/opt/mihomo
SECRET_KEY_A=replace-with-a-unique-secret
USERS_A="user1 user2"

# --- Server B ---
IP_B=198.51.100.10
PORT_B=22443
DIR_B=/opt/mihomo
ARCH_B=amd64
LISTEN_B=vless
SECRET_KEY_B=replace-with-a-unique-secret

# --- Server C ---
IP_C=203.0.113.20
PORT_C=8443
DIR_C=/opt/mihomo
ARCH_C=amd64
SECRET_KEY_C=replace-with-a-unique-secret
USERS_C="user1 user2"
KEYS_DIR_REMOTE=/opt/mihomo/keys
WEB_DIR_REMOTE=/var/www/html/mihomo
WEB_IP=203.0.113.20

# --- Server D (общие значения для типа D) ---
# D instances allowed to connect to each upstream relay.
D_TO_B_INSTANCES="D"
D_TO_C_INSTANCES="D"
IP_D=192.168.10.89
PORT_D=7893
DNS_PORT=1053
DIR_D=/opt/mihomo
ARCH_D=amd64
SECRET_KEY_D=replace-with-a-unique-secret
GEO_MODE=local
TUNNEL_C_HOST=203.0.113.20
TUNNEL_C_USER=root
TUNNEL_C_PORT=22
TUNNEL_REMOTE_PORT=2222
TUNNEL_KEY=/root/.ssh/id_ed25519_tunnel
D_INSTALL_TTL=28800

# --- Geodata ---
CN_CIDR_URL=https://cdn.jsdelivr.net/gh/gaoyifan/china-operator-ip@ip-lists/china.txt
RU_CIDR_URL=https://raw.githubusercontent.com/ipverse/rir-ip/master/country/ru/ipv4-aggregated.txt
GEOSITE_URL=https://github.com/hydraponique/roscomvpn-geosite/releases/latest/download/geosite.dat
GEOIP_METADB_URL=https://fastly.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.metadb
