# Copy to build/instances/D2.env and replace the example values.
# Values are literal: variable references such as ${IP_C} are not allowed.

IP_D=192.168.10.90
PORT_D=7893
DIR_D=/opt/mihomo
ARCH_D=amd64
SECRET_KEY_D=replace-with-a-unique-secret
GEO_MODE=local

# Give each D instance a distinct port on the shared C tunnel endpoint.
TUNNEL_C_HOST=198.51.100.20
TUNNEL_C_USER=root
TUNNEL_C_PORT=22
TUNNEL_REMOTE_PORT=2223
TUNNEL_KEY=/root/.ssh/id_ed25519_tunnel
