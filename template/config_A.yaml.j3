# =============================================================================
# template/config_A.yaml.j3 — шаблон конфигурации сервера A
# Сервер A: локальный, принимает только пользователей локальной сети.
# Наружу ходит через B (UUID_BA).
# =============================================================================
mixed-port: 7890
socks-port: 7896
#port: 7895
allow-lan: true
bind-address: "*"
mode: rule
log-level: info
external-controller: 127.0.0.1:9900
secret: "{{ SECRET_KEY }}"
external-ui: ui
ipv6: false

# --- ВХОДЯЩИЙ VLESS + REALITY для локальной сети ---
listeners:
  - name: vless-in
    type: vless
    port: {{ PORT_A }}
    listen: {{ IP_A }}
    users:
{% for u in USERS_A %}
      - username: {{ u }}
        flow: {{ FLOW_USERS }}
        uuid: "{{ UUID_A_{{ u }} }}"
{% endfor %}
    reality-config:
      dest: "{{ SERVERNAME }}:443"
      private-key: "{{ PRIVATE_KEY_A }}"
      short-id:
        - "{{ SHORT_ID_A }}"
      server-names:
        - "{{ SERVERNAME }}"

# --- Выход на B ---
proxies:
  - name: "to-serverB"
    type: vless
    server: {{ IP_B }}
    port: {{ PORT_B }}
    flow: {{ FLOW_AB }}
    uuid: "{{ UUID_BA }}"
    network: tcp
    reality-opts:
      public-key: "{{ PUBLIC_KEY_B }}"
      short-id: "{{ SHORT_ID_B }}"
    servername: {{ SERVERNAME }}
    client-fingerprint: {{ FINGERPRINT }}
    tls: true
    udp: false

proxy-groups:
  - name: PROXY
    type: select
    proxies:
      - to-serverB
      - DIRECT

dns:
  enable: true
  listen: 0.0.0.0:1053
  cache-algorithm: arc
  ipv6: false
  enhanced-mode: redir-host
  nameserver:
    - 77.88.8.8
    - 8.8.8.8
  fallback:
    - tls://1.1.1.1:853

rules:
  - DOMAIN,{{ SERVERNAME }},DIRECT,no-resolve
  - DOMAIN-SUFFIX,ru,DIRECT
  - DOMAIN-SUFFIX,su,DIRECT
  - DOMAIN-SUFFIX,xn--p1ai,DIRECT
  - GEOSITE,cn,DIRECT 
  - GEOIP,CN,DIRECT,no-resolve
  - GEOIP,RU,DIRECT,no-resolve
  - GEOIP,private,DIRECT,no-resolve
  - MATCH,PROXY